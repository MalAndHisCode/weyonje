{
  "openapi": "3.0.0",
  "paths": {
    "/v1/auth/sign-in": {
      "post": {
        "operationId": "AuthController_signIn",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionCredentialsDto"
                }
              }
            }
          },
          "401": {
            "description": "Generic response for all invalid account credentials or state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          },
          "429": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          }
        },
        "summary": "Sign in with an existing Weyonje account",
        "tags": [
          "authentication"
        ]
      }
    },
    "/v1/auth/client-code/request": {
      "post": {
        "operationId": "AuthController_requestClientCode",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClientCodeRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PhoneChallengeDto"
                }
              }
            }
          },
          "429": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          }
        },
        "summary": "Send a sign-in code to a Client phone number",
        "tags": [
          "authentication"
        ]
      }
    },
    "/v1/auth/client-code/verify": {
      "post": {
        "operationId": "AuthController_verifyClientCode",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyPhoneCodeDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionCredentialsDto"
                }
              }
            }
          },
          "401": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          }
        },
        "summary": "Sign in a Client with a phone verification code",
        "tags": [
          "authentication"
        ]
      }
    },
    "/v1/auth/client-code/resend": {
      "post": {
        "operationId": "AuthController_resendClientCode",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResendPhoneCodeDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PhoneChallengeDto"
                }
              }
            }
          }
        },
        "summary": "Replace and resend a Client sign-in code",
        "tags": [
          "authentication"
        ]
      }
    },
    "/v1/auth/refresh": {
      "post": {
        "operationId": "AuthController_refresh",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionCredentialsDto"
                }
              }
            }
          },
          "401": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          }
        },
        "summary": "Rotate a Weyonje refresh token",
        "tags": [
          "authentication"
        ]
      }
    },
    "/v1/auth/sign-out": {
      "post": {
        "operationId": "AuthController_signOut",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignOutDto"
                }
              }
            }
          },
          "401": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Revoke the current Weyonje session",
        "tags": [
          "authentication"
        ]
      }
    },
    "/v1/actors/me": {
      "get": {
        "operationId": "ActorsController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentActorDto"
                }
              }
            }
          },
          "401": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          },
          "403": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Resolve the authenticated Weyonje actor and mobile eligibility",
        "tags": [
          "actors"
        ]
      }
    }
  },
  "info": {
    "title": "Weyonje API",
    "description": "Native authentication, server-managed sessions, and authoritative eligibility for Weyonje clients.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "SignInDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "account@example.invalid"
          },
          "password": {
            "type": "string",
            "format": "password",
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "SessionCredentialsDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "accessTokenExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "refreshTokenExpiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "accessTokenExpiresAt",
          "refreshTokenExpiresAt"
        ]
      },
      "ApiErrorDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "AUTH_ACCESS_DENIED"
          },
          "message": {
            "type": "string",
            "example": "This account cannot access Weyonje mobile services."
          },
          "requestId": {
            "type": "string",
            "example": "2e96d4c8-5f83-4de0-957e-a7f0cff86690"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "ClientCodeRequestDto": {
        "type": "object",
        "properties": {
          "phoneNumber": {
            "type": "string",
            "example": "+256 700 000000"
          }
        },
        "required": [
          "phoneNumber"
        ]
      },
      "PhoneChallengeDto": {
        "type": "object",
        "properties": {
          "challengeId": {
            "type": "string",
            "format": "uuid"
          },
          "maskedPhone": {
            "type": "string",
            "example": "+256 •••••• 123"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "resendAvailableAt": {
            "type": "string",
            "format": "date-time"
          },
          "deliveryStatus": {
            "type": "string",
            "enum": [
              "SENT",
              "FAILED"
            ]
          }
        },
        "required": [
          "challengeId",
          "maskedPhone",
          "expiresAt",
          "resendAvailableAt",
          "deliveryStatus"
        ]
      },
      "VerifyPhoneCodeDto": {
        "type": "object",
        "properties": {
          "challengeId": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "pattern": "^[0-9]{6}$",
            "writeOnly": true
          }
        },
        "required": [
          "challengeId",
          "code"
        ]
      },
      "ResendPhoneCodeDto": {
        "type": "object",
        "properties": {
          "challengeId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "challengeId"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "SignOutDto": {
        "type": "object",
        "properties": {
          "signedOut": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "signedOut"
        ]
      },
      "CurrentActorDto": {
        "type": "object",
        "properties": {
          "actorType": {
            "type": "string",
            "enum": [
              "CLIENT",
              "SERVICE_PROVIDER",
              "KCCA_STAFF"
            ]
          },
          "access": {
            "type": "string",
            "enum": [
              "ELIGIBLE",
              "RESTRICTED",
              "DENIED"
            ]
          },
          "providerStatus": {
            "type": "string",
            "enum": [
              "PENDING",
              "APPROVED",
              "REJECTED",
              "INACTIVE",
              "DISABLED"
            ]
          },
          "providerNumber": {
            "type": "string",
            "example": "WSP-4A8F90CD12E3"
          },
          "providerRejectionReason": {
            "type": "string",
            "example": "The submitted ESS licence could not be validated."
          }
        },
        "required": [
          "actorType",
          "access"
        ]
      }
    }
  }
}
