{
  "openapi": "3.0.0",
  "paths": {
    "/v1/actors/me": {
      "get": {
        "operationId": "ActorsController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentActorDto"
                }
              }
            }
          },
          "401": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          },
          "403": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Resolve the authenticated Weyonje actor and mobile eligibility",
        "tags": [
          "actors"
        ]
      }
    }
  },
  "info": {
    "title": "Weyonje API",
    "description": "Authoritative identity and eligibility capabilities for Weyonje clients.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "CurrentActorDto": {
        "type": "object",
        "properties": {
          "actorType": {
            "type": "string",
            "enum": [
              "CLIENT",
              "SERVICE_PROVIDER",
              "KCCA_STAFF"
            ]
          },
          "access": {
            "type": "string",
            "enum": [
              "ELIGIBLE",
              "RESTRICTED",
              "DENIED"
            ]
          },
          "providerStatus": {
            "type": "string",
            "enum": [
              "PENDING",
              "APPROVED",
              "REJECTED",
              "INACTIVE",
              "DISABLED"
            ]
          }
        },
        "required": [
          "actorType",
          "access"
        ]
      },
      "ApiErrorDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "AUTH_ACCESS_DENIED"
          },
          "message": {
            "type": "string",
            "example": "This account cannot access Weyonje mobile services."
          },
          "requestId": {
            "type": "string",
            "example": "2e96d4c8-5f83-4de0-957e-a7f0cff86690"
          }
        },
        "required": [
          "code",
          "message"
        ]
      }
    }
  }
}
