  requestId         String            @unique(map: "uq_service_feedback_request") @map("request_id") @db.Uuid
  submittedByUserId String?           @map("submitted_by_user_id") @db.Uuid
  outcome           CollectionOutcome
  feedback          String            @db.VarChar(2000)
  rating            Int
  wasteCollected    Boolean           @map("waste_collected")
  submittedAt       DateTime          @default(now()) @map("submitted_at") @db.Timestamptz(3)
