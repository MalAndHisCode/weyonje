generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ActorType {
  CLIENT
  SERVICE_PROVIDER
  KCCA_STAFF

  @@map("actor_type")
}

enum ProviderStatus {
  PENDING
  APPROVED
  REJECTED
  INACTIVE
  DISABLED

  @@map("provider_status")
}

enum ThrottleScope {
  EMAIL
  PHONE
  IP

  @@map("throttle_scope")
}

enum ClientType {
  INDIVIDUAL
  ORGANIZATION

  @@map("client_type")
}

enum ServiceProviderType {
  GULPER
  EMPTIER

  @@map("service_provider_type")
}

enum PhoneChallengePurpose {
  REGISTRATION
  CLIENT_SIGN_IN
  PROVIDER_SIGN_IN

  @@map("phone_challenge_purpose")
}

enum PhoneChallengeDeliveryStatus {
  PENDING
  SENT
  FAILED

  @@map("phone_challenge_delivery_status")
}

enum ProviderApprovalDecision {
  APPROVED
  REJECTED

  @@map("provider_approval_decision")
}

enum NotificationType {
  PROVIDER_REVIEW_REQUIRED
  PROVIDER_APPROVED
  PROVIDER_REJECTED

  @@map("notification_type")
}

enum ServiceRequestOrigin {
  MOBILE_APP
  CALL_CENTRE

  @@map("service_request_origin")
}

enum ServiceRequestStatus {
  PENDING
  ACCEPTED
  ACTIVE
  COLLECTION_REPORTED
  COLLECTION_COMPLETED
  FOLLOW_UP_REQUIRED
  COMPLETED
  CANCELLED

  @@map("service_request_status")
}

enum RequestLocationKind {
  CURRENT
  MAP_PIN
  TEXT

  @@map("request_location_kind")
}

enum ToiletType {
  PIT_LATRINE
  SEPTIC_TANK

  @@map("toilet_type")
}

enum ScheduleMode {
  AS_SOON_AS_POSSIBLE
  SCHEDULED

  @@map("schedule_mode")
}

enum RequestAssignmentStatus {
  PENDING
  ACCEPTED
  REJECTED
  SUPERSEDED

  @@map("request_assignment_status")
}

enum JourneyPhase {
  TO_REQUEST
  TO_DISPOSAL

  @@map("journey_phase")
}

enum JourneyStatus {
  READY
  ACTIVE
  ARRIVED
  COMPLETED

  @@map("journey_status")
}

enum CollectionOutcome {
  COMPLETED
  LEFT_INCOMPLETE
  NOT_DONE_AT_ALL

  @@map("collection_outcome")
}

enum FollowUpStatus {
  OPEN
  RESOLVED

  @@map("follow_up_status")
}

enum OperationalNotificationType {
  REQUEST_CREATED
  REQUEST_ASSIGNED
  REQUEST_ACCEPTED
  REQUEST_REJECTED
  JOURNEY_STARTED
  PROVIDER_ARRIVED
  COLLECTION_REPORTED
  COLLECTION_CONFIRMED
  FOLLOW_UP_REQUIRED
  DISPOSAL_READY
  DISPOSAL_STARTED
  DISPOSAL_ARRIVED
  DISPOSAL_COMPLETED
  REMINDER
  PASSWORD_RECOVERY
  EMAIL_VERIFICATION
  PROVIDER_ACCOUNT_UPDATED

  @@map("operational_notification_type")
}

enum AccountChallengePurpose {
  PASSWORD_RECOVERY
  EMAIL_VERIFICATION

  @@map("account_challenge_purpose")
}

enum AccountChallengeChannel {
  SMS
  EMAIL

  @@map("account_challenge_channel")
}

enum NotificationDeliveryChannel {
  IN_APP
  SMS
  PUSH
  EMAIL

  @@map("notification_delivery_channel")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
  DEAD_LETTER

  @@map("outbox_status")
}

model User {
  id                            String                           @id @default(uuid()) @db.Uuid
  encryptedEmail                String?                          @map("encrypted_email") @db.VarChar(1024)
  emailLookup                   String?                          @unique(map: "uq_users_email_lookup") @map("email_lookup") @db.VarChar(64)
  passwordHash                  String?                          @map("password_hash") @db.VarChar(512)
  encryptedPhone                String?                          @map("encrypted_phone") @db.VarChar(1024)
  phoneLookup                   String?                          @unique(map: "uq_users_phone_lookup") @map("phone_lookup") @db.VarChar(64)
  actorType                     ActorType                        @map("actor_type")
  providerStatus                ProviderStatus?                  @map("provider_status")
  isActive                      Boolean                          @default(true) @map("is_active")
  loginEnabled                  Boolean                          @default(true) @map("login_enabled")
  emailVerifiedAt               DateTime?                        @map("email_verified_at") @db.Timestamptz(3)
  phoneVerifiedAt               DateTime?                        @map("phone_verified_at") @db.Timestamptz(3)
  mobileMonitoringPermitted     Boolean                          @default(false) @map("mobile_monitoring_permitted")
  providerApprovalPermitted     Boolean                          @default(false) @map("provider_approval_permitted")
  callCentreOperationsPermitted Boolean                          @default(false) @map("call_centre_operations_permitted")
  passwordChangedAt             DateTime                         @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  passwordVersion               Int                              @default(1) @map("password_version")
  failedLoginCount              Int                              @default(0) @map("failed_login_count")
  authenticationLockedUntil     DateTime?                        @map("authentication_locked_until") @db.Timestamptz(3)
  createdAt                     DateTime                         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                     DateTime                         @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions                      AuthenticationSession[]
  clientProfile                 ClientProfile?
  serviceProviderProfile        ServiceProviderProfile?
  phoneChallenges               PhoneChallenge[]
  approvalDecisionsMade         ProviderApprovalDecisionRecord[] @relation("ApprovalDecisionMaker")
  providerApprovalDecisions     ProviderApprovalDecisionRecord[] @relation("ApprovalSubject")
  providerStatusHistory         ProviderStatusHistory[]          @relation("ProviderStatusSubject")
  providerStatusChangesMade     ProviderStatusHistory[]          @relation("ProviderStatusActor")
  notifications                 RegistrationNotification[]
  clientRequests                ServiceRequest[]                 @relation("ClientRequests")
  requestsCreated               ServiceRequest[]                 @relation("CreatedRequests")
  acceptedRequests              ServiceRequest[]                 @relation("AcceptedProviderRequests")
  providerAssignments           RequestAssignment[]              @relation("ProviderAssignments")
  assignmentsMade               RequestAssignment[]              @relation("AssignmentsMade")
  providerJourneys              Journey[]                        @relation("ProviderJourneys")
  collectionReports             CollectionReport[]               @relation("ProviderCollectionReports")
  feedbackSubmissions           ServiceFeedback[]                @relation("FeedbackSubmitter")
  disposalAssignmentsMade       DisposalAssignment[]             @relation("DisposalAssignmentsMade")
  disposalAssignmentChangesMade DisposalAssignmentHistory[]      @relation("DisposalAssignmentHistoryActor")
  operationalNotifications      OperationalNotification[]
  auditEvents                   AuditEvent[]
  accountChallenges             AccountChallenge[]
  securityEvents                SecurityEvent[]
  deviceInstallations           DeviceInstallation[]

  @@index([actorType], map: "ix_users_actor_type")
  @@map("users")
}

model AccountChallenge {
  id                String                  @id @default(uuid()) @db.Uuid
  userId            String                  @map("user_id") @db.Uuid
  purpose           AccountChallengePurpose
  channel           AccountChallengeChannel
  secretHash        String                  @map("secret_hash") @db.VarChar(64)
  expiresAt         DateTime                @map("expires_at") @db.Timestamptz(3)
  resendAvailableAt DateTime                @map("resend_available_at") @db.Timestamptz(3)
  attemptsRemaining Int                     @default(5) @map("attempts_remaining")
  consumedAt        DateTime?               @map("consumed_at") @db.Timestamptz(3)
  supersededAt      DateTime?               @map("superseded_at") @db.Timestamptz(3)
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt], map: "ix_account_challenges_user_purpose_created")
  @@index([expiresAt], map: "ix_account_challenges_expiry")
  @@map("account_challenges")
}

model SecurityEvent {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  subjectHash String   @map("subject_hash") @db.VarChar(64)
  challengeId String?  @map("challenge_id") @db.Uuid
  action      String   @db.VarChar(100)
  outcome     String   @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([subjectHash, createdAt], map: "ix_security_events_subject_created")
  @@index([userId, createdAt], map: "ix_security_events_user_created")
  @@map("security_events")
}

model DeviceInstallation {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  installationId String    @map("installation_id") @db.Uuid
  environment    String    @db.VarChar(32)
  platform       String    @db.VarChar(32)
  tokenLookup    String    @unique(map: "uq_device_installations_token_lookup") @map("token_lookup") @db.VarChar(64)
  encryptedToken String    @map("encrypted_token") @db.VarChar(4096)
  active         Boolean   @default(true)
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  invalidatedAt  DateTime? @map("invalidated_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, installationId, environment], map: "uq_device_installations_user_installation_environment")
  @@index([userId, active], map: "ix_device_installations_user_active")
  @@map("device_installations")
}

model ClientProfile {
  userId                String     @id @map("user_id") @db.Uuid
  clientNumber          String?    @unique(map: "uq_client_profiles_client_number") @map("client_number") @db.VarChar(32)
  clientType            ClientType @map("client_type")
  firstName             String?    @map("first_name") @db.VarChar(100)
  lastName              String?    @map("last_name") @db.VarChar(100)
  organizationName      String?    @map("organization_name") @db.VarChar(200)
  contactPersonName     String?    @map("contact_person_name") @db.VarChar(200)
  encryptedContactPhone String?    @map("encrypted_contact_phone") @db.VarChar(1024)
  createdAt             DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("client_profiles")
}

model ServiceProviderProfile {
  userId                String              @id @map("user_id") @db.Uuid
  providerNumber        String?             @unique(map: "uq_service_provider_profiles_provider_number") @map("provider_number") @db.VarChar(32)
  essLicenseNumber      String              @map("ess_license_number") @db.VarChar(100)
  companyName           String              @map("company_name") @db.VarChar(200)
  workAddress           String              @map("work_address") @db.VarChar(500)
  providerType          ServiceProviderType @map("provider_type")
  contactPersonName     String              @map("contact_person_name") @db.VarChar(200)
  encryptedContactPhone String              @map("encrypted_contact_phone") @db.VarChar(1024)
  latestRejectionReason String?             @map("latest_rejection_reason") @db.VarChar(1000)
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([essLicenseNumber], map: "ix_service_provider_profiles_ess_license")
  @@map("service_provider_profiles")
}

model PhoneChallenge {
  id                String                       @id @db.Uuid
  userId            String?                      @map("user_id") @db.Uuid
  phoneLookup       String                       @map("phone_lookup") @db.VarChar(64)
  encryptedPhone    String                       @map("encrypted_phone") @db.VarChar(1024)
  purpose           PhoneChallengePurpose
  codeHash          String                       @map("code_hash") @db.VarChar(64)
  expiresAt         DateTime                     @map("expires_at") @db.Timestamptz(3)
  resendAvailableAt DateTime                     @map("resend_available_at") @db.Timestamptz(3)
  attemptsRemaining Int                          @default(5) @map("attempts_remaining")
  consumedAt        DateTime?                    @map("consumed_at") @db.Timestamptz(3)
  deliveryStatus    PhoneChallengeDeliveryStatus @default(PENDING) @map("delivery_status")
  providerMessageId String?                      @map("provider_message_id") @db.VarChar(255)
  createdAt         DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  user              User?                        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phoneLookup, purpose, createdAt], map: "ix_phone_challenges_phone_purpose_created")
  @@index([expiresAt], map: "ix_phone_challenges_expiry")
  @@map("phone_challenges")
}

model ProviderApprovalDecisionRecord {
  id              String                   @id @default(uuid()) @db.Uuid
  providerUserId  String                   @map("provider_user_id") @db.Uuid
  decidedByUserId String?                  @map("decided_by_user_id") @db.Uuid
  provenance      String                   @default("KCCA_MANUAL") @db.VarChar(40)
  decision        ProviderApprovalDecision
  reason          String?                  @db.VarChar(1000)
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  provider        User                     @relation("ApprovalSubject", fields: [providerUserId], references: [id], onDelete: Cascade)
  decidedBy       User?                    @relation("ApprovalDecisionMaker", fields: [decidedByUserId], references: [id], onDelete: Restrict)

  @@index([providerUserId, createdAt], map: "ix_provider_approval_decisions_subject_created")
  @@map("provider_approval_decisions")
}

model ProviderStatusHistory {
  id              String         @id @default(uuid()) @db.Uuid
  providerUserId  String         @map("provider_user_id") @db.Uuid
  changedByUserId String?        @map("changed_by_user_id") @db.Uuid
  provenance      String         @default("KCCA_MANUAL") @db.VarChar(40)
  fromStatus      ProviderStatus @map("from_status")
  toStatus        ProviderStatus @map("to_status")
  reason          String?        @db.VarChar(1000)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  provider        User           @relation("ProviderStatusSubject", fields: [providerUserId], references: [id], onDelete: Cascade)
  changedBy       User?          @relation("ProviderStatusActor", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([providerUserId, createdAt], map: "ix_provider_status_history_subject_created")
  @@map("provider_status_history")
}

model RegistrationNotification {
  id                 String           @id @default(uuid()) @db.Uuid
  recipientUserId    String?          @map("recipient_user_id") @db.Uuid
  recipientActorType ActorType?       @map("recipient_actor_type")
  type               NotificationType
  subjectUserId      String           @map("subject_user_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  readAt             DateTime?        @map("read_at") @db.Timestamptz(3)
  recipient          User?            @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientActorType, createdAt], map: "ix_registration_notifications_actor_created")
  @@index([recipientUserId, createdAt], map: "ix_registration_notifications_user_created")
  @@map("registration_notifications")
}

model AuthenticationSession {
  id                String         @id @default(uuid()) @db.Uuid
  userId            String         @map("user_id") @db.Uuid
  familyId          String         @map("family_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt        DateTime       @default(now()) @map("last_used_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime       @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt         DateTime?      @map("revoked_at") @db.Timestamptz(3)
  revocationReason  String?        @map("revocation_reason") @db.VarChar(64)
  passwordVersion   Int            @map("password_version")
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens     RefreshToken[]

  @@index([userId], map: "ix_authentication_sessions_user_id")
  @@index([familyId], map: "ix_authentication_sessions_family_id")
  @@index([absoluteExpiresAt], map: "ix_authentication_sessions_expiry")
  @@map("authentication_sessions")
}

model RefreshToken {
  id           String                @id @default(uuid()) @db.Uuid
  sessionId    String                @map("session_id") @db.Uuid
  tokenHash    String                @unique(map: "uq_refresh_tokens_token_hash") @map("token_hash") @db.VarChar(64)
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt    DateTime              @map("expires_at") @db.Timestamptz(3)
  usedAt       DateTime?             @map("used_at") @db.Timestamptz(3)
  revokedAt    DateTime?             @map("revoked_at") @db.Timestamptz(3)
  replacedById String?               @unique(map: "uq_refresh_tokens_replaced_by") @map("replaced_by_id") @db.Uuid
  session      AuthenticationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  replacedBy   RefreshToken?         @relation("RefreshRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces     RefreshToken?         @relation("RefreshRotation")

  @@index([sessionId], map: "ix_refresh_tokens_session_id")
  @@index([expiresAt], map: "ix_refresh_tokens_expiry")
  @@map("refresh_tokens")
}

model LoginThrottle {
  id              String        @id @default(uuid()) @db.Uuid
  scope           ThrottleScope
  keyHash         String        @map("key_hash") @db.VarChar(64)
  failedAttempts  Int           @default(0) @map("failed_attempts")
  windowStartedAt DateTime      @default(now()) @map("window_started_at") @db.Timestamptz(3)
  lockedUntil     DateTime?     @map("locked_until") @db.Timestamptz(3)
  expiresAt       DateTime      @map("expires_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([scope, keyHash], map: "uq_login_throttles_scope_key")
  @@index([expiresAt], map: "ix_login_throttles_expiry")
  @@map("login_throttles")
}

model ServiceRequest {
  id                        String                      @id @default(uuid()) @db.Uuid
  reference                 String                      @unique(map: "uq_service_requests_reference") @db.VarChar(32)
  origin                    ServiceRequestOrigin
  status                    ServiceRequestStatus        @default(PENDING)
  clientUserId              String?                     @map("client_user_id") @db.Uuid
  createdByUserId           String?                     @map("created_by_user_id") @db.Uuid
  acceptedProviderUserId    String?                     @map("accepted_provider_user_id") @db.Uuid
  clientName                String                      @map("client_name") @db.VarChar(240)
  encryptedClientPhone      String                      @map("encrypted_client_phone") @db.VarChar(1024)
  encryptedClientEmail      String?                     @map("encrypted_client_email") @db.VarChar(1024)
  locationKind              RequestLocationKind         @map("location_kind")
  locationText              String?                     @map("location_text") @db.VarChar(500)
  latitude                  Decimal?                    @db.Decimal(9, 6)
  longitude                 Decimal?                    @db.Decimal(9, 6)
  toiletType                ToiletType?                 @map("toilet_type")
  additionalContactName     String?                     @map("additional_contact_name") @db.VarChar(200)
  encryptedAdditionalPhone  String?                     @map("encrypted_additional_phone") @db.VarChar(1024)
  scheduleMode              ScheduleMode                @map("schedule_mode")
  requestedServiceAt        DateTime?                   @map("requested_service_at") @db.Timestamptz(3)
  agreedPriceUgx            Int?                        @map("agreed_price_ugx")
  acceptedAt                DateTime?                   @map("accepted_at") @db.Timestamptz(3)
  createdAt                 DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  client                    User?                       @relation("ClientRequests", fields: [clientUserId], references: [id], onDelete: Restrict)
  createdBy                 User?                       @relation("CreatedRequests", fields: [createdByUserId], references: [id], onDelete: Restrict)
  acceptedProvider          User?                       @relation("AcceptedProviderRequests", fields: [acceptedProviderUserId], references: [id], onDelete: Restrict)
  assignments               RequestAssignment[]
  statusHistory             RequestStatusHistory[]
  journeys                  Journey[]
  collectionReport          CollectionReport?
  feedback                  ServiceFeedback?
  followUpCase              FollowUpCase?
  disposalAssignment        DisposalAssignment?
  disposalAssignmentHistory DisposalAssignmentHistory[]
  notifications             OperationalNotification[]
  outboxEvents              OutboxEvent[]

  @@index([clientUserId, createdAt], map: "ix_service_requests_client_created")
  @@index([acceptedProviderUserId, updatedAt], map: "ix_service_requests_provider_updated")
  @@index([origin, status, createdAt], map: "ix_service_requests_origin_status_created")
  @@map("service_requests")
}

model RequestAssignment {
  id               String                  @id @default(uuid()) @db.Uuid
  requestId        String                  @map("request_id") @db.Uuid
  providerUserId   String                  @map("provider_user_id") @db.Uuid
  assignedByUserId String?                 @map("assigned_by_user_id") @db.Uuid
  status           RequestAssignmentStatus @default(PENDING)
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  decidedAt        DateTime?               @map("decided_at") @db.Timestamptz(3)
  request          ServiceRequest          @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider         User                    @relation("ProviderAssignments", fields: [providerUserId], references: [id], onDelete: Restrict)
  assignedBy       User?                   @relation("AssignmentsMade", fields: [assignedByUserId], references: [id], onDelete: Restrict)

  @@index([providerUserId, status, createdAt], map: "ix_request_assignments_provider_status")
  @@index([requestId, status], map: "ix_request_assignments_request_status")
  @@map("request_assignments")
}

model RequestStatusHistory {
  id          String                @id @default(uuid()) @db.Uuid
  requestId   String                @map("request_id") @db.Uuid
  fromStatus  ServiceRequestStatus? @map("from_status")
  toStatus    ServiceRequestStatus  @map("to_status")
  actorUserId String?               @map("actor_user_id") @db.Uuid
  reason      String?               @db.VarChar(500)
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  request     ServiceRequest        @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt], map: "ix_request_status_history_request_created")
  @@map("request_status_history")
}

model Journey {
  id             String            @id @default(uuid()) @db.Uuid
  requestId      String            @map("request_id") @db.Uuid
  providerUserId String            @map("provider_user_id") @db.Uuid
  phase          JourneyPhase
  status         JourneyStatus     @default(READY)
  startedAt      DateTime?         @map("started_at") @db.Timestamptz(3)
  arrivedAt      DateTime?         @map("arrived_at") @db.Timestamptz(3)
  completedAt    DateTime?         @map("completed_at") @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  request        ServiceRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider       User              @relation("ProviderJourneys", fields: [providerUserId], references: [id], onDelete: Restrict)
  positions      JourneyPosition[]

  @@unique([requestId, phase], map: "uq_journeys_request_phase")
  @@index([providerUserId, status], map: "ix_journeys_provider_status")
  @@map("journeys")
}

model JourneyPosition {
  id                 String   @id @default(uuid()) @db.Uuid
  journeyId          String   @map("journey_id") @db.Uuid
  sampleId           String   @map("sample_id") @db.Uuid
  deviceTimestamp    DateTime @map("device_timestamp") @db.Timestamptz(3)
  receivedAt         DateTime @default(now()) @map("received_at") @db.Timestamptz(3)
  latitude           Decimal  @db.Decimal(9, 6)
  longitude          Decimal  @db.Decimal(9, 6)
  accuracyMetres     Decimal  @map("accuracy_metres") @db.Decimal(8, 2)
  acceptedForArrival Boolean  @default(false) @map("accepted_for_arrival")
  journey            Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@unique([journeyId, sampleId], map: "uq_journey_positions_sample")
  @@index([journeyId, deviceTimestamp], map: "ix_journey_positions_journey_time")
  @@index([receivedAt], map: "ix_journey_positions_received")
  @@map("journey_positions")
}

model CollectionReport {
  id                   String         @id @default(uuid()) @db.Uuid
  requestId            String         @unique(map: "uq_collection_reports_request") @map("request_id") @db.Uuid
  reportedByProviderId String         @map("reported_by_provider_id") @db.Uuid
  reportedAt           DateTime       @default(now()) @map("reported_at") @db.Timestamptz(3)
  request              ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider             User           @relation("ProviderCollectionReports", fields: [reportedByProviderId], references: [id], onDelete: Restrict)

  @@map("collection_reports")
}

model ServiceFeedback {
