  name              String                      @db.VarChar(200)
  address           String                      @db.VarChar(500)
  latitude          Decimal                     @db.Decimal(9, 6)
  longitude         Decimal                     @db.Decimal(9, 6)
  active            Boolean                     @default(true)
  approvedAt        DateTime                    @default(now()) @map("approved_at") @db.Timestamptz(3)
  createdAt         DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  assignments       DisposalAssignment[]
  assignmentHistory DisposalAssignmentHistory[]

  @@index([active, name], map: "ix_disposal_sites_active_name")
  @@map("disposal_sites")
}

model DisposalAssignment {
  id               String         @id @default(uuid()) @db.Uuid
  requestId        String         @unique(map: "uq_disposal_assignments_request") @map("request_id") @db.Uuid
  disposalSiteId   String         @map("disposal_site_id") @db.Uuid
  assignedByUserId String         @map("assigned_by_user_id") @db.Uuid
  assignedAt       DateTime       @default(now()) @map("assigned_at") @db.Timestamptz(3)
  request          ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  disposalSite     DisposalSite   @relation(fields: [disposalSiteId], references: [id], onDelete: Restrict)
  assignedBy       User           @relation("DisposalAssignmentsMade", fields: [assignedByUserId], references: [id], onDelete: Restrict)

  @@map("disposal_assignments")
}

model DisposalAssignmentHistory {
  id               String         @id @default(uuid()) @db.Uuid
  requestId        String         @map("request_id") @db.Uuid
  disposalSiteId   String         @map("disposal_site_id") @db.Uuid
  assignedByUserId String         @map("assigned_by_user_id") @db.Uuid
  assignedAt       DateTime       @default(now()) @map("assigned_at") @db.Timestamptz(3)
  request          ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  disposalSite     DisposalSite   @relation(fields: [disposalSiteId], references: [id], onDelete: Restrict)
  assignedBy       User           @relation("DisposalAssignmentHistoryActor", fields: [assignedByUserId], references: [id], onDelete: Restrict)

  @@index([requestId, assignedAt], map: "ix_disposal_assignment_history_request_time")
  @@map("disposal_assignment_history")
}

model OperationalNotification {
  id                  String                      @id @default(uuid()) @db.Uuid
  recipientUserId     String                      @map("recipient_user_id") @db.Uuid
  requestId           String?                     @map("request_id") @db.Uuid
  type                OperationalNotificationType
  title               String                      @db.VarChar(200)
  message             String                      @db.VarChar(1000)
  createdAt           DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  readAt              DateTime?                   @map("read_at") @db.Timestamptz(3)
  sourceOutboxEventId String?                     @unique(map: "uq_operational_notifications_source_outbox") @map("source_outbox_event_id") @db.Uuid
  recipient           User                        @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  request             ServiceRequest?             @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, createdAt], map: "ix_operational_notifications_recipient_created")
  @@map("operational_notifications")
}

model OutboxEvent {
  id               String                      @id @default(uuid()) @db.Uuid
  requestId        String?                     @map("request_id") @db.Uuid
  recipientUserId  String?                     @map("recipient_user_id") @db.Uuid
  channel          NotificationDeliveryChannel
  eventType        OperationalNotificationType @map("event_type")
  deduplicationKey String                      @unique(map: "uq_outbox_events_deduplication") @map("deduplication_key") @db.VarChar(200)
  payload          Json
  status           OutboxStatus                @default(PENDING)
  attempts         Int                         @default(0)
  nextAttemptAt    DateTime                    @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  claimedAt        DateTime?                   @map("claimed_at") @db.Timestamptz(3)
  claimExpiresAt   DateTime?                   @map("claim_expires_at") @db.Timestamptz(3)
  claimToken       String?                     @map("claim_token") @db.Uuid
  deliveredAt      DateTime?                   @map("delivered_at") @db.Timestamptz(3)
  deadLetteredAt   DateTime?                   @map("dead_lettered_at") @db.Timestamptz(3)
  lastErrorCode    String?                     @map("last_error_code") @db.VarChar(100)
  createdAt        DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  request          ServiceRequest?             @relation(fields: [requestId], references: [id], onDelete: Cascade)
  attemptsHistory  DeliveryAttempt[]

  @@index([status, nextAttemptAt], map: "ix_outbox_events_status_next")
  @@index([status, claimExpiresAt], map: "ix_outbox_events_status_claim_expiry")
  @@map("outbox_events")
}

model DeliveryAttempt {
  id                String                      @id @default(uuid()) @db.Uuid
  outboxEventId     String                      @map("outbox_event_id") @db.Uuid
  attemptNumber     Int                         @map("attempt_number")
  channel           NotificationDeliveryChannel
  result            String                      @db.VarChar(32)
  errorCode         String?                     @map("error_code") @db.VarChar(100)
  providerMessageId String?                     @map("provider_message_id") @db.VarChar(255)
  startedAt         DateTime                    @default(now()) @map("started_at") @db.Timestamptz(3)
  completedAt       DateTime?                   @map("completed_at") @db.Timestamptz(3)
  outboxEvent       OutboxEvent                 @relation(fields: [outboxEventId], references: [id], onDelete: Cascade)

  @@unique([outboxEventId, attemptNumber], map: "uq_delivery_attempts_event_number")
  @@index([result, completedAt], map: "ix_delivery_attempts_result_completed")
  @@map("delivery_attempts")
}

model IdempotencyRecord {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  operation   String   @db.VarChar(100)
  key         String   @db.VarChar(100)
  fingerprint String   @db.VarChar(64)
  response    Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)

  @@unique([actorUserId, operation, key], map: "uq_idempotency_actor_operation_key")
  @@index([expiresAt], map: "ix_idempotency_records_expiry")
  @@map("idempotency_records")
}

model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(100)
  targetType  String   @map("target_type") @db.VarChar(100)
  targetId    String   @map("target_id") @db.Uuid
  requestId   String?  @map("request_id") @db.Uuid
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([targetType, targetId, createdAt], map: "ix_audit_events_target_created")
  @@map("audit_events")
}
