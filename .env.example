# API runtime. Copy to an ignored .env file or configure the deployment secret store.
NODE_ENV=development
WEYONJE_ENVIRONMENT=local
PORT=3000

# Keycloak / OIDC. The access token must contain the expected audience and the configured role.
KEYCLOAK_ISSUER=https://keycloak.example.invalid/realms/weyonje-local
KEYCLOAK_JWKS_URI=https://keycloak.example.invalid/realms/weyonje-local/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=weyonje-api-local
KEYCLOAK_ALLOWED_ALGORITHMS=RS256
KEYCLOAK_CLIENT_ROLE=weyonje-client
KEYCLOAK_PROVIDER_ROLE=weyonje-service-provider
KEYCLOAK_KCCA_MOBILE_ROLE=weyonje-kcca-mobile-monitor

# PostgreSQL. Replace the password in an ignored local file or deployment secret store.
DATABASE_HOST=postgres.example.invalid
DATABASE_PORT=5432
DATABASE_NAME=weyonje_local
DATABASE_USER=weyonje_api
DATABASE_PASSWORD=<store-outside-source-control>
DATABASE_SSL=true

