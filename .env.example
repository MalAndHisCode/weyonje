# Weyonje API runtime. Copy to an ignored .env file and replace every placeholder.
NODE_ENV=development
WEYONJE_ENVIRONMENT=local
PORT=3000

# Neon: pooled connection for the API and direct connection for Prisma migrations/admin scripts.
DATABASE_URL=postgresql://<runtime-user>:<password>@<pooled-neon-host>/<database>?sslmode=require
DIRECT_URL=postgresql://<migration-user>:<password>@<direct-neon-host>/<database>?sslmode=require

# Native API authentication coordinates.
AUTH_ISSUER=https://<api-host>
AUTH_AUDIENCE=weyonje-api-development
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=604800

# Eight independent base64 secrets. Generate each separately; never reuse values.
# EMAIL_ENCRYPTION_KEY and PII_ENCRYPTION_KEY must decode to exactly 32 bytes;
# the others require at least 32 bytes.
ACCESS_TOKEN_SECRET=<base64-32-or-more-random-bytes>
EMAIL_ENCRYPTION_KEY=<base64-exactly-32-random-bytes>
EMAIL_LOOKUP_KEY=<base64-32-or-more-random-bytes>
REFRESH_TOKEN_HASH_KEY=<base64-32-or-more-random-bytes>
THROTTLE_HASH_KEY=<base64-32-or-more-random-bytes>
PII_ENCRYPTION_KEY=<base64-exactly-32-random-bytes>
PHONE_LOOKUP_KEY=<base64-32-or-more-random-bytes>
OTP_HASH_KEY=<base64-32-or-more-random-bytes>

# Bounded login throttling and temporary account lock settings.
AUTH_ACCOUNT_MAX_ATTEMPTS=5
AUTH_IP_MAX_ATTEMPTS=20
AUTH_THROTTLE_WINDOW_SECONDS=900
AUTH_LOCK_SECONDS=900

# Phone verification and Client phone-code sign-in.
OTP_TTL_SECONDS=600
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_HOUR=5

# Africa's Talking SMS. Use the sandbox origin only with sandbox credentials.
AFRICASTALKING_API_BASE_URL=https://api.sandbox.africastalking.com
AFRICASTALKING_USERNAME=<africastalking-app-username>
AFRICASTALKING_API_KEY=<africastalking-api-key>
AFRICASTALKING_SENDER_ID=<approved-sender-id>

# Provisional location policy. KCCA approval is required before production use.
LOCATION_SAMPLE_INTERVAL_SECONDS=15
LOCATION_SAMPLE_DISTANCE_METRES=25
LOCATION_ARRIVAL_RADIUS_METRES=75
LOCATION_ARRIVAL_MAX_ACCURACY_METRES=50
LOCATION_STALE_AFTER_SECONDS=60
LOCATION_RETENTION_DAYS=90
LOCATION_BACKGROUND_TRACKING_ENABLED=true
